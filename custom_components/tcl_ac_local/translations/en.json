  "config": {
    "flow_title": "TCL AC Local",
    "step": {
      "user": {
        "title": "TCL Home account",
        "description": "Use the same email/phone and password as the TCL Home app. Recommended: a separate account with shared devices.",
        "data": {
          "username": "TCL Home email or phone",
          "password": "Password"
        }
      },
      "settings_of_app": {
        "title": "App endpoints",
        "description": "Leave defaults unless TCL changes them.",
        "data": {
          "app_login_url": "App login URL",
          "cloud_urls": "Cloud URLs",
          "app_id": "App Id"
        }
      },
      "settings_of_logs": {
        "title": "Logging",
        "description": "Logs: Settings → System → Logs → Show raw logs.",
        "data": {
          "verbose_device_logging": "Device logs",
          "verbose_session_logging": "Session / token logs",
          "verbose_setup_logging": "Setup logs"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "description": "Account changes trigger a TCL Home re-login."
      },
      "option_page_account": {
        "title": "TCL Home account",
        "description": "Same credentials as the TCL Home app.",
        "data": {
          "username": "Email or phone",
          "password": "Password"
        }
      },
      "option_page_tcl_app": {
        "title": "App endpoints",
        "description": "Android app endpoints. Change only if TCL updates them.",
        "data": {
          "app_login_url": "App login URL",
          "cloud_urls": "Cloud URLs",
          "app_id": "App Id"
        }
      },
      "option_page_logs": {
        "title": "Logging",
